{
  "name": "glisil-coque",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "description": "Glisil · la coque Android (et iOS) de l'application cliente : une WebView, le pont vers le téléphone, le verrou biométrique, les mises à jour",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "build:android:test": "npx eas-cli@latest build -p android --profile preview",
    "build:android": "npx eas-cli@latest build -p android --profile production",
    "submit:android": "npx eas-cli@latest submit -p android --profile production",
    "update:production": "npx eas-cli@latest update --channel production --environment production",
    "update:preview": "npx eas-cli@latest update --channel preview --environment preview"
  },
  "dependencies": {
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~57.0.25",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-local-authentication": "~57.0.3",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.23",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
