{
  "expo": {
    "name": "Glisil",
    "slug": "glisil",
    "scheme": "glisil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F7F4",
    "ios": {
      "bundleIdentifier": "com.glisil.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Glisil utilise Face ID pour que vous seul puissiez ouvrir l'application."
      }
    },
    "android": {
      "package": "com.glisil.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B6B3A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.USE_BIOMETRIC", "android.permission.USE_FINGERPRINT"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO", "android.permission.SYSTEM_ALERT_WINDOW", "android.permission.CAMERA"],
      "predictiveBackGestureEnabled": false
    },
    "web": { "favicon": "./assets/favicon.png" },
    "plugins": [
      "expo-sharing",
      ["expo-splash-screen", { "image": "./assets/splash-icon.png", "imageWidth": 160, "resizeMode": "contain", "backgroundColor": "#0B6B3A" }],
      "expo-web-browser",
      ["expo-local-authentication", { "faceIDPermission": "Glisil utilise Face ID pour que vous seul puissiez ouvrir l'application." }]
    ],
    "extra": {
      "baseUrl": "https://app.glisil.com",
      "startPath": "/"
    },
    "runtimeVersion": { "policy": "appVersion" },
    "updates": { "checkAutomatically": "ON_LOAD", "fallbackToCacheTimeout": 0 }
  }
}
